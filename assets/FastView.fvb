  <block name="БМРЗ - Защита электродвигателей (с 2025 г.в.)">
    <characteristic name="1 ступень защиты от асинхронного режима без потери возбуждения" dimension="OHM">
      <parameter name="ЗАР1_Zср" default="50.0"/>
      <parameter name="ЗАР1_Zсм" default="2.0"/>
      <parameter name="ЗАР1_Ф" default="45.0"/>
      <var name="xc" expression="ЗАР1_Zср/(2*tg:(ЗАР1_Ф))"/> 
      <var name="yc" expression="(ЗАР1_Zср-ЗАР1_Zсм)/2"/> 
      <var name="p" expression="(ЗАР1_Zср+ЗАР1_Zсм)/2"/> 
      <circle mode="on" radius="sqrt:(xc^2+p^2)" xcenter="xc" ycenter="yc"/>
      <circle mode="off" radius="1.05*sqrt:(xc^2+p^2)" xcenter="1.05*xc" ycenter="1.05*yc"/>
    </characteristic>
    <characteristic name="2 ступень защиты от асинхронного режима без потери возбуждения" dimension="OHM">
      <parameter name="ЗАР2_Zср" default="50.0"/>
      <parameter name="ЗАР2_Zсм" default="2.0"/>
      <parameter name="ЗАР2_Ф" default="270"/>
      <var name="xc" expression="-ЗАР2_Zср/(2*tg:(ЗАР2_Ф))"/> 
      <var name="yc" expression="-(ЗАР2_Zср-ЗАР2_Zсм)/2"/> 
      <var name="p" expression="(ЗАР2_Zср+ЗАР2_Zсм)/2"/> 
      <circle mode="on" radius="sqrt:(xc^2+p^2)" xcenter="xc" ycenter="yc"/>
      <circle mode="off" radius="1.05*sqrt:(xc^2+p^2)" xcenter="1.05*xc" ycenter="1.05*yc"/>
    </characteristic>
    <characteristic name="Защита от потери возбуждения" dimension="OHM">
      <parameter name="ЗПВ_Zср" default="60.0"/>
      <parameter name="ЗПВ_Zсм" default="2.0"/>
      <var name="R" expression="(ЗПВ_Zср-ЗПВ_Zсм)/2"/> 
      <circle mode="on" radius="R" xcenter="0" ycenter="-(ЗПВ_Zсм+R)"/>
      <circle mode="off" radius="1.05*R" xcenter="0" ycenter="-(ЗПВ_Zсм+R)"/>
    </characteristic>
	<characteristic name="ДТО" dimension="DIF">
      <parameter name="ДТО_I" default="5.00"/>
      <var name="DtoRt" expression="ДТО_I"/>
      <var name="DtoRtV" expression="DtoRt*0.95"/>
      <polypoint mode="on" closed="off"> 
        <line x="0" y="DtoRt+1"/>
        <line x="0.0001" y="DtoRt"/>
        <line x="1" y="DtoRt"/>
      </polypoint>
      <polypoint mode="off" closed="off">
        <line x="0" y="DtoRtV+1"/>
        <line x="0.00001" y="DtoRtV"/>
        <line x="1" y="DtoRtV"/>
      </polypoint>
   </characteristic>
   <characteristic name="ДЗТ" dimension="DIF">
      <parameter name="ДЗТ_I" default="0.30"/>
      <parameter name="ДЗТ_Iт2" default="0.50"/>
      <parameter name="ДЗТ_Кт2" default="0.50"/>
      <parameter name="ДЗТ_Iт3" default="1.50"/>
      <parameter name="ДЗТ_Кт3" default="0.70"/>
      <var name="DztNach" expression="ДЗТ_I"/>
      <var name="DztNt2" expression="ДЗТ_Iт2"/>
      <var name="DztNt3" expression="ДЗТ_Iт3"/>
      <var name="DztKt2" expression="ДЗТ_Кт2"/>
      <var name="DztKt3" expression="ДЗТ_Кт3"/>
      <var name="DztNachV" expression="DztNach*0.95"/>
      <polypoint mode="on" closed="off"> 
        <line x="0" y="DztNach+1"/>
        <line x="0.00001" y="DztNach"/>
        <line x="DztNt2" y="DztNach"/>
        <line x="DztNt3" y="DztNach+DztKt2*(DztNt3-DztNt2)"/>
        <line x="DztNt3+1" y="DztNach+DztKt2*(DztNt3-DztNt2)+DztKt3"/>
      </polypoint>
      <polypoint mode="off" closed="off">
        <line x="0" y="DztNachV+1"/>
        <line x="0.0001" y="DztNachV"/>
        <line x="DztNt2" y="DztNachV"/>
        <line x="DztNt3" y="DztNachV+DztKt2*(DztNt3-DztNt2)"/>
        <line x="DztNt3+1" y="DztNachV+DztKt2*(DztNt3-DztNt2)+DztKt3"/>
      </polypoint>
  </characteristic>
  <characteristic name="ДЗТ грубый" dimension="DIF">
      <parameter name="ДЗТ_Iгр" default="1.00"/>
      <var name="DtoRt" expression="ДЗТ_Iгр"/>
      <var name="DtoRtV" expression="DtoRt*0.95"/>
      <polypoint mode="on" closed="off"> 
        <line x="0" y="DtoRt+1"/>
        <line x="0.0001" y="DtoRt"/>
        <line x="1" y="DtoRt"/>
      </polypoint>
      <polypoint mode="off" closed="off">
        <line x="0" y="DtoRtV+1"/>
        <line x="0.00001" y="DtoRtV"/>
        <line x="1" y="DtoRtV"/>
      </polypoint>
   </characteristic>   
   
  <characteristic name="Сигнализация небаланса" dimension="DIF">
      <parameter name="ДЗТ_Iнб" default="0.20"/>
	  <parameter name="ДЗТ_Iт2" default="0.50"/>
      <parameter name="ДЗТ_Кт2" default="0.50"/>
      <var name="DztNach" expression="ДЗТ_Iнб"/>
      <var name="DztNt2" expression="ДЗТ_Iт2"/>
      <var name="DztNt3" expression="ДЗТ_Iт2+1.0"/>
      <var name="DztKt2" expression="ДЗТ_Кт2"/>
      <var name="DztNachV" expression="DztNach*0.95"/>
      <polypoint mode="on" closed="off"> 
        <line x="0" y="DztNach+1"/>
        <line x="0.00001" y="DztNach"/>
        <line x="DztNt2" y="DztNach"/>
        <line x="DztNt3" y="DztNach+DztKt2*(DztNt3-DztNt2)"/>
      </polypoint>
      <polypoint mode="off" closed="off">
        <line x="0" y="DztNachV+1"/>
        <line x="0.0001" y="DztNachV"/>
        <line x="DztNt2" y="DztNachV"/>
        <line x="DztNt3" y="DztNachV+DztKt2*(DztNt3-DztNt2)"/>
      </polypoint>
  </characteristic>
  </block>
  
  <block name="БМРЗ - Защита трансформаторов (с 2025 г.в.)">
   <characteristic name="ДТО" dimension="DIF">
      <parameter name="ДТО_I" default="5.00"/>
      <var name="DtoRt" expression="ДТО_I"/>
      <var name="DtoRtV" expression="DtoRt*0.95"/>
      <polypoint mode="on" closed="off"> 
        <line x="0" y="DtoRt+1"/>
        <line x="0.0001" y="DtoRt"/>
