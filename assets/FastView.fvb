      <var name="DztNachV" expression="DztNach*0.95"/>
      <polypoint mode="on" closed="off"> 
        <line x="0" y="DztNach+1"/>
        <line x="0.00001" y="DztNach"/>
        <line x="DztNt2" y="DztNach"/>
        <line x="DztNt3" y="DztNach+DztKt2*(DztNt3-DztNt2)"/>
      </polypoint>
      <polypoint mode="off" closed="off">
        <line x="0" y="DztNachV+1"/>
        <line x="0.0001" y="DztNachV"/>
        <line x="DztNt2" y="DztNachV"/>
        <line x="DztNt3" y="DztNachV+DztKt2*(DztNt3-DztNt2)"/>
      </polypoint>
  </characteristic>   
  </block>
  
  <block name="БМРЗ - Защита фидеров контактной сети 10 кВ (с 2025 г.в.)">
  <characteristic name="Характеристика Сектор ДЗМФ 1 ступень" dimension="OHM">
      <parameter name="ДЗМФ1_Zср" default="10.0"/>
      <parameter name="ДЗМФ1_Ф1" default="5"/>
      <parameter name="ДЗМФ1_Ф2" default="100"/>    

		<polygon mode="on">
			<line k="tg:(ДЗМФ1_Ф1)" b="0" type="1"/>
			<line k="0" b="ДЗМФ1_Zср*100" type="1"/>
			<line k="tg:(ДЗМФ1_Ф2)" b="0" type="1"/>
		</polygon>		
      <circle type="and" mode="on" radius="ДЗМФ1_Zср" xcenter="0" ycenter="0"/>

		<polygon mode="off">
			<line k="tg:(ДЗМФ1_Ф1-4)" b="0" type="1"/>
			<line k="0" b="ДЗМФ1_Zср*100" type="1"/>
			<line k="tg:(ДЗМФ1_Ф2+4)" b="0" type="1"/>
		</polygon>		
      <circle type="and" mode="off" radius="1.05*ДЗМФ1_Zср" xcenter="0" ycenter="0"/>
    </characteristic>
	<characteristic name="Характеристика Сектор ДЗМФ 2 ступень" dimension="OHM">
      <parameter name="ДЗМФ2_Zср" default="20.0"/>
      <parameter name="ДЗМФ2_Ф1" default="45"/>
      <parameter name="ДЗМФ2_Ф2" default="110"/>     

		<polygon mode="on">
			<line k="tg:(ДЗМФ2_Ф1)" b="0" type="1"/>
			<line k="0" b="ДЗМФ2_Zср*100" type="1"/>
			<line k="tg:(ДЗМФ2_Ф2)" b="0" type="1"/>
		</polygon>		
      <circle type="and" mode="on" radius="ДЗМФ2_Zср" xcenter="0" ycenter="0"/>

		<polygon mode="off">
			<line k="tg:(ДЗМФ2_Ф1-4)" b="0" type="1"/>
			<line k="0" b="ДЗМФ2_Zср*100" type="1"/>
			<line k="tg:(ДЗМФ2_Ф2+4)" b="0" type="1"/>
		</polygon>		
      <circle type="and" mode="off" radius="1.05*ДЗМФ2_Zср" xcenter="0" ycenter="0"/>
    </characteristic>
	<characteristic name="Характеристика Окружность ННДЗМФ" dimension="OHM">
      <parameter name="ННДЗМФ_Zср" default="3.0"/>
      <circle mode="on" radius="ННДЗМФ_Zср" xcenter="0" ycenter="0"/>
      <circle mode="off" radius="1.05*ННДЗМФ_Zср" xcenter="0" ycenter="0"/>
    </characteristic>
    <characteristic name="Полигональная характеристика" dimension="OHM">
      <parameter name="ДЗМФ3_Rср" default="20.0"/>
      <parameter name="ДЗМФ3_X1" default="1.0"/>
      <parameter name="ДЗМФ3_X2" default="2.0"/>
      <parameter name="ДЗМФ3_X3" default="-1.0"/>
      <parameter name="ДЗМФ3_X4" default="-2.0"/>
      <var name="ДЗ_R" expression="ДЗМФ3_Rср"/>
      <var name="ДЗ_Хн1" expression="ДЗМФ3_X1"/>
      <var name="ДЗ_Хк1" expression="ДЗМФ3_X2"/>
      <var name="ДЗ_Хн2" expression="ДЗМФ3_X3"/>
      <var name="ДЗ_Хк2" expression="ДЗМФ3_X4"/>
    <polygon mode="on">
        <line k="(ДЗ_Хк1-ДЗ_Хн1)/ДЗ_R" b="ДЗ_Хн1" type="1"/>
        <line k="0" b="ДЗ_R" type="2"/>
        <line k="(ДЗ_Хк2-ДЗ_Хн2)/ДЗ_R" b="ДЗ_Хн2" type="1"/>
        <line k="0" b="0" type="2"/>
      </polygon>
  </characteristic>   
  </block>
  
  <block name="БМРЗ - Защита линий 6-35 кВ (с 2025 г.в.)">
   <characteristic name="ДЗМФ1 ступень" dimension="OHM">
      <parameter name="ДЗМФ1_Nхар" default="2"/>
      <parameter name="ДЗМФ1_Zcp" default="5.0"/>
      <parameter name="ДЗМФ1_Ф" default="50"/>
      <parameter name="ДЗМФ1_Ф1" default="-10"/>
      <parameter name="ДЗМФ1_Ф2" default="50"/>
      <parameter name="ДЗМФ1_Rср" default="2.0"/>
      <parameter name="ДЗМФ1_Ксм" default="0.00"/>
      <parameter name="ДЗМФ1_Zсм" default="0.0"/>
      <parameter name="Ввод_инвертирования_ДЗМФ1" default="0"/>
      <parameter name="Ввод_нагрузочной_зоны_для_характеристики_ДЗМФ1" default="0"/>
      <parameter name="ДЗМФ_Rн" default="30"/>
      <parameter name="ДЗМФ_Фн" default="15"/>	  
      <var name="Load" expression="Ввод_нагрузочной_зоны_для_характеристики_ДЗМФ1"/>
      <var name="Zcp" expression="ДЗМФ1_Zcp"/> 
      <var name="Zcm" expression="ДЗМФ1_Zсм"/> 
      <var name="Fмч" expression="ДЗМФ1_Ф"/> 
      <var name="D" expression="(Zcp-Zcm)"/> 
      <var name="Направленность" expression="Ввод_инвертирования_ДЗМФ1"/>
      <var name="N" expression="-2*Направленность + 1"/> 
      <var name="Zy" expression="ДЗМФ1_Zcp"/>
      <var name="Kcm" expression="ДЗМФ1_Ксм"/>
      <var name="Fz" expression="ДЗМФ1_Ф"/>
      <var name="F1" expression="ДЗМФ1_Ф1"/>
      <var name="F2" expression="ДЗМФ1_Ф2"/>
      <var name="Ry" expression="ДЗМФ1_Rср"/>
      <var name="N" expression="-2*Направленность + 1"/>
      <var name="A" expression="(tg:(5.00001)*cos:(Fz)+sin:(Fz))"/>
      <var name="A1" expression="(tg:(-F1)*cos:(Fz)+sin:(Fz))"/>
      <var name="KZ" expression="Kcm * (-Zy) + (1.05 - 1) * mod:(Kcm * (-Zy))"/>
      <var name="Type" expression="ДЗМФ1_Nхар"/>
      <var name="kn" expression="tg:(ДЗМФ_Фн)"/>
      <var name="knv" expression="tg:(ДЗМФ_Фн-5)"/>
      <var name="Rn" expression="ДЗМФ_Rн"/>
<polygon mode="on">
        <line k="tg:(-5.00001)" b="N*Zy*A" type="1"/>
        <line k="tg:(F1)" b="N*Zy*A1" type="1"/>
        <line k="tg:(90-F2)" b="N* Ry" type="2"/>
        <line k="-tg:(5)" b="-N* Kcm*Zy * A" type="1"/>
        <line k="-tg:(15)" b="-0.125 *N* Ry" type="2"/>
      </polygon>
<polygon mode="off">
        <line k="tg:(-5.00001)" b="1.05*Zy*A*N" type="1"/>
        <line k="tg:(F1)" b="1.05*N*Zy*A1" type="1"/>
        <line k="tg:(90-F2)" b=" 1.05*Ry*N" type="2"/>
        <line k="-tg:(5)" b="-KZ*A*N" type="1"/>
        <line k="-tg:(15)" b="-0.125 * Ry*1.05*N" type="2"/>
      </polygon>
<polygon type="and" mode="on">
        <line k="tg:(-5.00001)" b="Zy*A*N" type="1"/>
        <line k="tg:(90-F2)" b=" Ry*N" type="2"/>
        <line k="-tg:(15)" b="-0.125 * Ry*N" type="2"/>
      </polygon>
<polygon type="and" mode="off">
        <line k="tg:(-5)" b="1.05*Zy*A*N" type="1"/>
        <line k="tg:(90-F2)" b=" 1.05*Ry*N" type="2"/>
        <line k="-tg:(15)" b="-0.125 * Ry*1.05*N" type="2"/>
</polygon>
      <circle type="and" mode="on" radius="10*Zy*(Type-1)*(-0.5*Type+1.5)" xcenter="0" ycenter="0"/>
      <circle type="and" mode="off" radius="10*Zy*(Type-1)*(-0.5*Type+1.5)" xcenter="0" ycenter="0"/>
      <circle type="or" mode="on" radius="(Zcp+Zcm)*(-Type+2)*(-0.5*Type+1.5)/2" xcenter="D/2*cos:(Fмч)*N" ycenter="D/2*sin:(Fмч)*N"/>
      <circle type="or" mode="off" radius="1.05*(Zcp+Zcm)*(-Type+2)*(-0.5*Type+1.5)/2" xcenter="0.525*D*cos:(Fмч)*N" ycenter="0.525*D*sin:(Fмч)*N"/>
<polygon type="not" mode="on">
        <line k="0" b="Rn" type="2"/>
        <line k="kn*Load" b="0" type="1"/>
        <line k="0" b="100*Zy*Rn" type="2"/>
        <line k="-kn*Load" b="0" type="1"/>
</polygon>
<polygon type="not" mode="on">
        <line k="0" b="-Rn" type="2"/>
        <line k="kn*Load" b="0" type="1"/>
        <line k="0" b="-100*Zy*Rn" type="2"/>
        <line k="-kn*Load" b="0" type="1"/>
</polygon>
<polygon type="not" mode="off">
        <line k="0" b="1.05*Rn" type="2"/>
        <line k="knv*Load" b="0" type="1"/>
        <line k="0" b="100*Zy*Rn" type="2"/>
        <line k="-knv*Load" b="0" type="1"/>
</polygon>
<polygon type="not" mode="off">
        <line k="0" b="-1.05*Rn" type="2"/>
        <line k="knv*Load" b="0" type="1"/>
        <line k="0" b="-100*Zy*Rn" type="2"/>
        <line k="-knv*Load" b="0" type="1"/>
</polygon>
  </characteristic> 
  
  <characteristic name="ДЗМФ1 ступень (дополнительная)" dimension="OHM">
      <parameter name="ДЗМФд1_Nхар" default="2"/>
      <parameter name="ДЗМФд1_Zcp" default="5.0"/>
      <parameter name="ДЗМФд1_Ф" default="50"/>
      <parameter name="ДЗМФд1_Ф1" default="-10"/>
      <parameter name="ДЗМФд1_Ф2" default="50"/>
      <parameter name="ДЗМФд1_Rср" default="2.0"/>
      <parameter name="ДЗМФд1_Ксм" default="0.00"/>
      <parameter name="ДЗМФд1_Zсм" default="0.0"/>
      <parameter name="Ввод_нагрузочной_зоны_для_характеристики_ДЗМФд1" default="0"/>
      <parameter name="ДЗМФд_Rн" default="30"/>
      <parameter name="ДЗМФд_Фн" default="15"/>	  
      <var name="Load" expression="Ввод_нагрузочной_зоны_для_характеристики_ДЗМФд1"/>
      <var name="Zcp" expression="ДЗМФд1_Zcp"/> 
      <var name="Zcm" expression="ДЗМФд1_Zсм"/> 
      <var name="Fмч" expression="ДЗМФд1_Ф"/> 
      <var name="D" expression="(Zcp-Zcm)"/> 
      <var name="Направленность" expression="1"/>
      <var name="N" expression="-2*Направленность + 1"/> 
      <var name="Zy" expression="ДЗМФд1_Zcp"/>
      <var name="Kcm" expression="ДЗМФд1_Ксм"/>
      <var name="Fz" expression="ДЗМФд1_Ф"/>
      <var name="F1" expression="ДЗМФд1_Ф1"/>
      <var name="F2" expression="ДЗМФд1_Ф2"/>
      <var name="Ry" expression="ДЗМФд1_Rср"/>
      <var name="N" expression="-2*Направленность + 1"/>
      <var name="A" expression="(tg:(5.00001)*cos:(Fz)+sin:(Fz))"/>
      <var name="A1" expression="(tg:(-F1)*cos:(Fz)+sin:(Fz))"/>
      <var name="KZ" expression="Kcm * (-Zy) + (1.05 - 1) * mod:(Kcm * (-Zy))"/>
      <var name="Type" expression="ДЗМФд1_Nхар"/>
      <var name="kn" expression="tg:(ДЗМФд_Фн)"/>
      <var name="knv" expression="tg:(ДЗМФд_Фн-5)"/>
      <var name="Rn" expression="ДЗМФд_Rн"/>
<polygon mode="on">
        <line k="tg:(-5.00001)" b="N*Zy*A" type="1"/>
        <line k="tg:(F1)" b="N*Zy*A1" type="1"/>
        <line k="tg:(90-F2)" b="N* Ry" type="2"/>
        <line k="-tg:(5)" b="-N* Kcm*Zy * A" type="1"/>
        <line k="-tg:(15)" b="-0.125 *N* Ry" type="2"/>
      </polygon>
<polygon mode="off">
        <line k="tg:(-5.00001)" b="1.05*Zy*A*N" type="1"/>
        <line k="tg:(F1)" b="1.05*N*Zy*A1" type="1"/>
        <line k="tg:(90-F2)" b=" 1.05*Ry*N" type="2"/>
        <line k="-tg:(5)" b="-KZ*A*N" type="1"/>
        <line k="-tg:(15)" b="-0.125 * Ry*1.05*N" type="2"/>
      </polygon>
<polygon type="and" mode="on">
        <line k="tg:(-5.00001)" b="Zy*A*N" type="1"/>
        <line k="tg:(90-F2)" b=" Ry*N" type="2"/>
        <line k="-tg:(15)" b="-0.125 * Ry*N" type="2"/>
      </polygon>
<polygon type="and" mode="off">
        <line k="tg:(-5)" b="1.05*Zy*A*N" type="1"/>
        <line k="tg:(90-F2)" b=" 1.05*Ry*N" type="2"/>
