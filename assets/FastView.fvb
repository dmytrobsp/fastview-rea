      <circle type="or" mode="on" radius="(Zcp+Zcm)*(-Type+2)*(-0.5*Type+1.5)/2" xcenter="D/2*cos:(Fмч)*N" ycenter="D/2*sin:(Fмч)*N"/>
      <circle type="or" mode="off" radius="1.05*(Zcp+Zcm)*(-Type+2)*(-0.5*Type+1.5)/2" xcenter="0.525*D*cos:(Fмч)*N" ycenter="0.525*D*sin:(Fмч)*N"/>
<polygon type="not" mode="on">
        <line k="0" b="-Rn" type="2"/>
        <line k="kn*Load" b="0" type="1"/>
        <line k="0" b="-100*Zy*Rn" type="2"/>
        <line k="-kn*Load" b="0" type="1"/>
</polygon>
<polygon type="not" mode="off">
        <line k="0" b="-1.05*Rn" type="2"/>
        <line k="knv*Load" b="0" type="1"/>
        <line k="0" b="-100*Zy*Rn" type="2"/>
        <line k="-knv*Load" b="0" type="1"/>
</polygon>
  </characteristic>  
 </block>
    
  <block name="БМРЗ - Защита генераторов (с 2025 г.в.)">
    <characteristic name="1 ступень защиты от асинхронного режима без потери возбуждения" dimension="OHM">
      <parameter name="ЗАР1_Zср" default="50.0"/>
      <parameter name="ЗАР1_Zсм" default="2.0"/>
      <parameter name="ЗАР1_Ф" default="45.0"/>
      <var name="xc" expression="ЗАР1_Zср/(2*tg:(ЗАР1_Ф))"/> 
      <var name="yc" expression="(ЗАР1_Zср-ЗАР1_Zсм)/2"/> 
      <var name="p" expression="(ЗАР1_Zср+ЗАР1_Zсм)/2"/> 
      <circle mode="on" radius="sqrt:(xc^2+p^2)" xcenter="xc" ycenter="yc"/>
      <circle mode="off" radius="1.05*sqrt:(xc^2+p^2)" xcenter="1.05*xc" ycenter="1.05*yc"/>
    </characteristic>
    <characteristic name="2 ступень защиты от асинхронного режима без потери возбуждения" dimension="OHM">
      <parameter name="ЗАР2_Zср" default="50.0"/>
      <parameter name="ЗАР2_Zсм" default="2.0"/>
      <parameter name="ЗАР2_Ф" default="270"/>
      <var name="xc" expression="-ЗАР2_Zср/(2*tg:(ЗАР2_Ф))"/> 
      <var name="yc" expression="-(ЗАР2_Zср-ЗАР2_Zсм)/2"/> 
      <var name="p" expression="(ЗАР2_Zср+ЗАР2_Zсм)/2"/> 
      <circle mode="on" radius="sqrt:(xc^2+p^2)" xcenter="xc" ycenter="yc"/>
      <circle mode="off" radius="1.05*sqrt:(xc^2+p^2)" xcenter="1.05*xc" ycenter="1.05*yc"/>
    </characteristic>
    <characteristic name="Защита от потери возбуждения" dimension="OHM">
      <parameter name="ЗПВ_Zср" default="60.0"/>
      <parameter name="ЗПВ_Zсм" default="2.0"/>
      <var name="R" expression="(ЗПВ_Zср-ЗПВ_Zсм)/2"/> 
      <circle mode="on" radius="R" xcenter="0" ycenter="-(ЗПВ_Zсм+R)"/>
      <circle mode="off" radius="1.05*R" xcenter="0" ycenter="-(ЗПВ_Zсм+R)"/>
    </characteristic>
	<characteristic name="ДТО" dimension="DIF">
      <parameter name="ДТО_I" default="5.00"/>
      <var name="DtoRt" expression="ДТО_I"/>
      <var name="DtoRtV" expression="DtoRt*0.95"/>
      <polypoint mode="on" closed="off"> 
        <line x="0" y="DtoRt+1"/>
        <line x="0.0001" y="DtoRt"/>
        <line x="1" y="DtoRt"/>
      </polypoint>
      <polypoint mode="off" closed="off">
        <line x="0" y="DtoRtV+1"/>
        <line x="0.00001" y="DtoRtV"/>
        <line x="1" y="DtoRtV"/>
      </polypoint>
   </characteristic>
   <characteristic name="ДЗТ" dimension="DIF">
      <parameter name="ДЗТ_I" default="0.30"/>
      <parameter name="ДЗТ_Iт2" default="0.50"/>
      <parameter name="ДЗТ_Кт2" default="0.50"/>
      <parameter name="ДЗТ_Iт3" default="1.50"/>
      <parameter name="ДЗТ_Кт3" default="0.70"/>
      <var name="DztNach" expression="ДЗТ_I"/>
      <var name="DztNt2" expression="ДЗТ_Iт2"/>
      <var name="DztNt3" expression="ДЗТ_Iт3"/>
      <var name="DztKt2" expression="ДЗТ_Кт2"/>
      <var name="DztKt3" expression="ДЗТ_Кт3"/>
      <var name="DztNachV" expression="DztNach*0.95"/>
      <polypoint mode="on" closed="off"> 
        <line x="0" y="DztNach+1"/>
        <line x="0.00001" y="DztNach"/>
        <line x="DztNt2" y="DztNach"/>
        <line x="DztNt3" y="DztNach+DztKt2*(DztNt3-DztNt2)"/>
        <line x="DztNt3+1" y="DztNach+DztKt2*(DztNt3-DztNt2)+DztKt3"/>
      </polypoint>
      <polypoint mode="off" closed="off">
        <line x="0" y="DztNachV+1"/>
        <line x="0.0001" y="DztNachV"/>
        <line x="DztNt2" y="DztNachV"/>
        <line x="DztNt3" y="DztNachV+DztKt2*(DztNt3-DztNt2)"/>
        <line x="DztNt3+1" y="DztNachV+DztKt2*(DztNt3-DztNt2)+DztKt3"/>
      </polypoint>
  </characteristic>
  <characteristic name="ДЗТ гр." dimension="DIF">
      <parameter name="ДЗТ_Iгр" default="1.00"/>
      <var name="DtoRt" expression="ДЗТ_Iгр"/>
      <var name="DtoRtV" expression="DtoRt*0.95"/>
      <polypoint mode="on" closed="off"> 
        <line x="0" y="DtoRt+1"/>
        <line x="0.0001" y="DtoRt"/>
        <line x="1" y="DtoRt"/>
      </polypoint>
      <polypoint mode="off" closed="off">
        <line x="0" y="DtoRtV+1"/>
        <line x="0.00001" y="DtoRtV"/>
        <line x="1" y="DtoRtV"/>
      </polypoint>
   </characteristic>
   <characteristic name="Сигнализация небаланса" dimension="DIF">
      <parameter name="ДЗТ_Iнб" default="0.20"/>
	  <parameter name="ДЗТ_Iт2" default="0.50"/>
      <parameter name="ДЗТ_Кт2" default="0.50"/>
      <var name="DztNach" expression="ДЗТ_Iнб"/>
      <var name="DztNt2" expression="ДЗТ_Iт2"/>
      <var name="DztNt3" expression="ДЗТ_Iт2+1.0"/>
      <var name="DztKt2" expression="ДЗТ_Кт2"/>
      <var name="DztNachV" expression="DztNach*0.95"/>
      <polypoint mode="on" closed="off"> 
        <line x="0" y="DztNach+1"/>
        <line x="0.00001" y="DztNach"/>
        <line x="DztNt2" y="DztNach"/>
        <line x="DztNt3" y="DztNach+DztKt2*(DztNt3-DztNt2)"/>
      </polypoint>
      <polypoint mode="off" closed="off">
        <line x="0" y="DztNachV+1"/>
        <line x="0.0001" y="DztNachV"/>
        <line x="DztNt2" y="DztNachV"/>
        <line x="DztNt3" y="DztNachV+DztKt2*(DztNt3-DztNt2)"/>
      </polypoint>
  </characteristic>
  </block>
  <block name="БМРЗ - Защита генераторов 0.4 кВ (с 2025 г.в.)">
   <characteristic name="ДЗТ НП" dimension="DIF">
      <parameter name="ДЗТ_НП_нач" default="0.30"/>      
      <parameter name="ДЗТ_НП_Кторм" default="0.30"/>
      <var name="DztNach" expression="ДЗТ_НП_нач"/>
      <var name="DztNt2" expression="1.0"/>
      <var name="DztKt2" expression="ДЗТ_НП_Кторм"/>
      <var name="DztNachV" expression="DztNach*0.95"/>
      <polypoint mode="on" closed="off"> 
        <line x="0" y="DztNach+1"/>
        <line x="0.000001" y="DztNach"/>
        <line x="DztNt2" y="DztNach"/>
        <line x="DztNt2+1" y="DztNach+DztKt2"/>
      </polypoint>
      <polypoint mode="off" closed="off">
        <line x="0" y="DztNachV+1"/>
        <line x="0.00001" y="DztNachV"/>
        <line x="DztNt2" y="DztNachV"/>
        <line x="DztNt2+1" y="DztNachV+DztKt2"/>
      </polypoint>
  </characteristic> 
  </block>
  
  <block name="Универсальные характеристики">
   <characteristic name="Четырехугольная характеристика" dimension="OHM">
      <parameter name="Zcp" default="10.0"/>
      <parameter name="Фл" default="70"/>
      <parameter name="Ф1" default="-5"/>
      <parameter name="Rср" default="5.0"/>
      <parameter name="Ф2" default="70"/>
      <parameter name="Ксм" default="0.20"/>
	  <parameter name="Ф3" default="-5"/>
      <parameter name="Rобр" default="5.0"/>
      <parameter name="Ф4" default="70"/>
      <parameter name="Направленность_к_шинам" default="0"/>
      <parameter name="Ввод_нагрузочной_зоны_несрабатывания" default="0"/>
      <parameter name="Rн" default="30"/>
      <parameter name="Фн" default="15"/>
      <var name="Load" expression="Ввод_нагрузочной_зоны_несрабатывания"/>
      <var name="N" expression="-2*Направленность_к_шинам + 1"/> 
      <var name="A1" expression="(-tg:(Ф1)*cos:(Фл)+sin:(Фл))"/>
      <var name="A3" expression="(-tg:(Ф3)*cos:(Фл)+sin:(Фл))"/>
      <var name="KZ" expression="Ксм * Zcp + (1.05 - 1) * mod:(Ксм * Zcp)"/>
      <var name="kn" expression="tg:(Фн)"/>
      <var name="knv" expression="tg:(Фн-5)"/>
<polygon mode="on">
        <line k="tg:(Ф1)" b="N*Zcp*A1" type="1"/>
        <line k="tg:(90-Ф2)" b="N* Rср" type="2"/>
        <line k="tg:(Ф3)" b="-N* Ксм*Zcp * A3" type="1"/>
        <line k="tg:(90-Ф4)" b="-N* Rобр" type="2"/>
      </polygon>
<polygon mode="off">
        <line k="tg:(Ф1)" b="1.05*N*Zcp*A1" type="1"/>
        <line k="tg:(90-Ф2)" b="1.05*N* Rср" type="2"/>
        <line k="tg:(Ф3)" b="-1.05*N* Ксм*Zcp * A3" type="1"/>
        <line k="tg:(90-Ф4)" b="-1.05*N* Rобр" type="2"/>
      </polygon>
<polygon type="not" mode="on">
        <line k="0" b="Rн" type="2"/>
        <line k="kn*Load" b="0" type="1"/>
        <line k="0" b="100*Zcp*Rн" type="2"/>
        <line k="-kn*Load" b="0" type="1"/>
</polygon>
<polygon type="not" mode="on">
        <line k="0" b="-Rн" type="2"/>
        <line k="kn*Load" b="0" type="1"/>
        <line k="0" b="-100*Zcp*Rн" type="2"/>
        <line k="-kn*Load" b="0" type="1"/>
</polygon>
<polygon type="not" mode="off">
        <line k="0" b="1.05*Rн" type="2"/>
        <line k="knv*Load" b="0" type="1"/>
        <line k="0" b="100*Zcp*Rн" type="2"/>
        <line k="-knv*Load" b="0" type="1"/>
</polygon>
<polygon type="not" mode="off">
        <line k="0" b="-1.05*Rн" type="2"/>
        <line k="knv*Load" b="0" type="1"/>
        <line k="0" b="-100*Zcp*Rн" type="2"/>
        <line k="-knv*Load" b="0" type="1"/>
</polygon>
  </characteristic>
   <characteristic name="Эллиптическая характеристика" dimension="OHM">
      <parameter name="Zcp" default="10.0"/>
      <parameter name="Фл" default="70"/>
      <parameter name="Ксм" default="0.20"/>
      <parameter name="Кэ" default="0.5"/>
      <parameter name="Направленность_к_шинам" default="0"/>
      <parameter name="Ввод_нагрузочной_зоны_несрабатывания" default="0"/>
      <parameter name="Rн" default="30"/>
      <parameter name="Фн" default="15"/>
      <var name="Load" expression="Ввод_нагрузочной_зоны_несрабатывания"/>
      <var name="N" expression="-2*Направленность_к_шинам + 1"/> 
      <var name="xc" expression="N*cos:(Фл)*(1-Ксм)/2*Zcp"/>
      <var name="yc" expression="N*sin:(Фл)*(1-Ксм)/2*Zcp"/>
      <var name="xcv" expression="N*1.05*cos:(Фл)*(1-Ксм)/2*Zcp"/>
      <var name="ycv" expression="N*1.05*sin:(Фл)*(1-Ксм)/2*Zcp"/>
      <var name="w" expression="(Ксм+1) * Zcp"/>
	  <var name="h" expression="w*Кэ"/>
      <var name="wv" expression="1.05*(Ксм+1) * Zcp"/>
	  <var name="hv" expression="wv*Кэ"/>
      <var name="kn" expression="tg:(Фн)"/>
      <var name="knv" expression="tg:(Фн-5)"/>
      <ellipse type="and" mode="on" xcenter="xc" ycenter="yc" width="w" height="h" angle="Фл" />
      <ellipse type="and" mode="off" xcenter="xcv" ycenter="ycv" width="wv" height="hv" angle="Фл" />
<polygon type="not" mode="on">
        <line k="0" b="Rн" type="2"/>
        <line k="kn*Load" b="0" type="1"/>
        <line k="0" b="100*Zcp*Rн" type="2"/>
        <line k="-kn*Load" b="0" type="1"/>
</polygon>
<polygon type="not" mode="on">
        <line k="0" b="-Rн" type="2"/>
        <line k="kn*Load" b="0" type="1"/>
        <line k="0" b="-100*Zcp*Rн" type="2"/>
        <line k="-kn*Load" b="0" type="1"/>
</polygon>
<polygon type="not" mode="off">
        <line k="0" b="1.05*Rн" type="2"/>
        <line k="knv*Load" b="0" type="1"/>
        <line k="0" b="100*Zcp*Rн" type="2"/>
        <line k="-knv*Load" b="0" type="1"/>
</polygon>
<polygon type="not" mode="off">
        <line k="0" b="-1.05*Rн" type="2"/>
        <line k="knv*Load" b="0" type="1"/>
        <line k="0" b="-100*Zcp*Rн" type="2"/>
        <line k="-knv*Load" b="0" type="1"/>
</polygon>
  </characteristic>
  </block>
  <block name="Реле направления мощности">
    <characteristic name="РНМ" dimension="OHM">
      <parameter name="Фмч" default="-30"/>
      <polygon type="and" mode="on">
        <line k="tg:(Фмч+85)" b="0" type="1"/>
        <line k="Фмч/900" b="10" type="1"/>
        <line k="tg:(Фмч+95)" b="0" type="1"/>
        <line k="Фмч/900" b="-10" type="1"/>
      </polygon>
      <circle type="and" mode="on" radius="5" xcenter="0" ycenter="0"/>
    </characteristic>
  </block>
  
  </blocks>