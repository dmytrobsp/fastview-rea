      </polypoint>
      <polypoint mode="off" closed="off">
        <line x="0" y="DtoRtV+1"/>
        <line x="0.0001" y="DtoRtV"/>
        <line x="1" y="DtoRtV"/>
      </polypoint>
  </characteristic>
   <characteristic name="ДЗТ" dimension="DIF">
