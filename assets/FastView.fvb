     <characteristic name="Чувствительная ДЗТ" dimension="DIF">
      <parameter name="ДЗТ_нач" default="1.00"/>
      <parameter name="ДЗТ_Кт" default="0.50"/>
      <var name="DztNach" expression="ДЗТ_нач"/>
      <var name="DztKt2" expression="ДЗТ_Кт"/>
